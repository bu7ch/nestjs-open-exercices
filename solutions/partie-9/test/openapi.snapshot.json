    "/v2/api/produits": {
      "get": {
        "operationId": "ProduitsController_lister_v2",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Numéro de la page, à partir de 1",
            "schema": {
              "minimum": 1,
              "default": 1,
              "type": "number"
            }
          },
          {
            "name": "limite",
            "required": false,
            "in": "query",
            "description": "Nombre d'éléments par page",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "recherche",
            "required": false,
            "in": "query",
            "description": "Texte cherché dans le nom (sans tenir compte des majuscules)",
            "schema": {
              "maxLength": 50,
              "type": "string"
            }
          },
          {
            "name": "categorie",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "papeterie",
                "informatique",
                "mobilier"
              ]
            }
          },
          {
            "name": "prixMin",
            "required": false,
            "in": "query",
            "description": "Prix minimal, en centimes",
            "schema": {
              "minimum": 0,
              "example": 1000,
              "type": "number"
            }
          },
          {
            "name": "prixMax",
            "required": false,
            "in": "query",
            "description": "Prix maximal, en centimes",
            "schema": {
              "minimum": 0,
              "example": 5000,
              "type": "number"
            }
          },
          {
            "name": "tri",
            "required": false,
            "in": "query",
            "schema": {
              "default": "id",
              "type": "string",
              "enum": [
                "id",
                "nom",
                "prix"
              ]
            }
          },
          {
            "name": "ordre",
            "required": false,
            "in": "query",
            "schema": {
              "default": "desc",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "donnees",
                        "meta"
                      ],
                      "properties": {
                        "donnees": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ProduitReponseDto"
                          }
                        },
                        "meta": {
                          "$ref": "#/components/schemas/MetaPage"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (paramètre ou corps refusé)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErreurDto"
                }
              }
            }
          },
          "401": {
            "description": "Jeton manquant, invalide ou expiré",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErreurDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Liste les produits actifs, paginés, filtrés et triés",
        "tags": [
          "produits"
        ]
      }
    },
