  "info": {
    "title": "API Marketplace",
    "description": "Catalogue de produits, vendeurs, commandes et comptes de la marketplace.",
    "version": "2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "InscriptionDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Adresse e-mail (unique)",
            "example": "alice@exemple.fr"
          },
          "motDePasse": {
            "type": "string",
            "description": "Mot de passe, 8 caractères au moins",
            "minLength": 8,
            "example": "MotDePasse!42"
          }
        },
        "required": [
          "email",
          "motDePasse"
        ]
      },
      "ConnexionDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Adresse e-mail du compte",
            "example": "alice@exemple.fr"
          },
          "motDePasse": {
            "type": "string",
            "description": "Mot de passe du compte",
            "example": "MotDePasse!42"
          }
        },
        "required": [
          "email",
          "motDePasse"
        ]
      },
      "RafraichirDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Le refresh token reçu à la connexion"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ErreurDeChampDto": {
        "type": "object",
        "properties": {
          "champ": {
            "type": "string",
            "example": "limite"
          },
          "erreurs": {
            "example": [
              "limite must not be greater than 100"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "champ",
          "erreurs"
        ]
      },
      "ErreurDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Produit 9 introuvable"
          },
          "chemin": {
            "type": "string",
            "example": "/api/produits/9"
          },
          "horodatage": {
            "type": "string",
            "format": "date-time"
          },
          "requeteId": {
            "type": "string",
            "description": "Identifiant à communiquer pour retrouver l'erreur dans les journaux"
          },
          "champs": {
            "description": "Présent pour les erreurs de validation : une entrée par champ",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErreurDeChampDto"
            }
          }
        },
        "required": [
          "statusCode",
          "message",
          "chemin",
          "horodatage"
        ]
      },
      "ProduitReponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Identifiant du produit",
            "example": 12
          },
          "nom": {
            "type": "string",
            "description": "Nom affiché du produit",
            "example": "Lampe de bureau"
          },
          "prix": {
            "type": "string",
            "description": "Prix unitaire en euros, deux décimales (texte, pour ne rien perdre en précision)",
            "example": "30.00"
          },
          "categorie": {
            "type": "string",
            "description": "Catégorie du produit",
            "enum": [
              "papeterie",
              "informatique",
              "mobilier"
            ],
            "example": "mobilier"
          },
          "actif": {
            "type": "boolean",
            "description": "Faux si le produit est retiré de la vente",
            "example": true
          },
          "prixAchat": {
            "type": "string",
            "description": "Prix d'achat : visible seulement du vendeur propriétaire et d'un admin (8.11)",
            "example": "18.00",
            "nullable": true
          }
        },
        "required": [
          "id",
          "nom",
          "prix",
          "categorie",
          "actif"
        ]
      },
      "MetaPage": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "example": 2
          },
          "limite": {
            "type": "number",
            "example": 20
          },
          "total": {
            "type": "number",
            "example": 57
          },
          "totalPages": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "page",
          "limite",
          "total",
          "totalPages"
        ]
      },
      "CreerProduitDto": {
        "type": "object",
        "properties": {
          "nom": {
            "type": "string",
            "description": "Nom du produit",
            "example": "Lampe de bureau"
          },
          "prix": {
            "type": "number",
            "description": "Prix unitaire en euros",
            "minimum": 0,
            "example": 30
          },
          "categorie": {
            "type": "string",
            "enum": [
              "papeterie",
              "informatique",
              "mobilier"
            ],
            "example": "mobilier"
          },
          "prixAchat": {
            "type": "number",
            "description": "Prix d'achat en euros (visible du propriétaire et d'un admin)",
            "minimum": 0,
            "example": 18
          }
        },
        "required": [
          "nom",
          "prix",
          "categorie"
        ]
      },
      "RenommerProduitDto": {
        "type": "object",
        "properties": {
          "nom": {
            "type": "string",
            "description": "Nouveau nom du produit",
            "example": "Lampe d'architecte"
          }
        },
        "required": [
          "nom"
        ]
      },
      "CreerVarianteDto": {
        "type": "object",
        "properties": {
          "nom": {
            "type": "string",
            "description": "Nom de la variante",
            "example": "Rouge"
          },
          "stock": {
            "type": "number",
            "description": "Stock disponible",
            "minimum": 0,
            "default": 0
          }
        },
        "required": [
          "nom"
        ]
      },
      "CreerVendeurDto": {
        "type": "object",
        "properties": {
          "nom": {
            "type": "string",
            "description": "Nom de la boutique",
            "example": "Atelier du Bois"
          }
        },
        "required": [
          "nom"
        ]
      },
      "CreerCommandeDto": {
        "type": "object",
        "properties": {
          "lignes": {
            "description": "Les lignes de la commande",
            "example": [
              {
                "varianteId": 1,
                "quantite": 2
              }
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "lignes"
        ]
      },
      "CalculerTotalDto": {
        "type": "object",
        "properties": {
          "prixUnitaire": {
            "type": "number",
            "description": "Prix unitaire en euros",
            "minimum": 0,
            "example": 0.7
          },
          "quantite": {
            "type": "number",
            "description": "Nombre d'unités",
            "minimum": 1,
            "example": 12
          }
        },
        "required": [
          "prixUnitaire",
          "quantite"
        ]
      },
      "LigneClassementVendeurDto": {
        "type": "object",
        "properties": {
          "rang": {
            "type": "number",
            "description": "Position dans le classement, à partir de 1",
            "example": 1
          },
          "vendeurId": {
            "type": "number",
            "description": "Identifiant du vendeur",
            "example": 3
          },
          "nom": {
            "type": "string",
            "description": "Nom du vendeur",
            "example": "Atelier du Bois"
          },
          "commandes": {
            "type": "number",
            "description": "Nombre de commandes contenant au moins un produit du vendeur",
            "example": 12
          },
          "chiffreAffaires": {
            "type": "number",
            "description": "Chiffre d'affaires total, en euros (quantité × prix des lignes du vendeur)",
            "example": 1234.5
          }
        },
        "required": [
          "rang",
          "vendeurId",
          "nom",
          "commandes",
          "chiffreAffaires"
        ]
      }
    }
  }
}