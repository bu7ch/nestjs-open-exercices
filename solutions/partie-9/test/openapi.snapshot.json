                    "data": {
                      "type": "object",
                      "required": [
                        "donnees",
                        "meta"
                      ],
                      "properties": {
                        "donnees": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/LigneClassementVendeurDto"
