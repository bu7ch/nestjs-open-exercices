{
  "name": "nestjs-open-exercices",
  "version": "0.0.1",
  "description": "Dépôt d'exercices de NestJS Open : tes exercices, leurs tests, et les solutions.",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:nba": "nest start --watch --sourceRoot bonus-nba/src --entryFile bonus-nba/src/main --path tsconfig.json",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config ./vitest.config.unit.ts",
    "test:unit:watch": "vitest --config ./vitest.config.unit.ts",
    "test:cov": "vitest run --config ./vitest.config.unit.ts --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:partie-3": "vitest run exercices/partie-3",
    "test:partie-4": "vitest run exercices/partie-4",
    "test:partie-5": "vitest run exercices/partie-5",
    "test:partie-6": "vitest run exercices/partie-6",
    "test:partie-7": "vitest run exercices/partie-7",
    "test:partie-8": "vitest run exercices/partie-8",
    "test:partie-9": "vitest run exercices/partie-9",
    "test:partie-10": "vitest run exercices/partie-10",
    "test:partie-11": "vitest run exercices/partie-11",
    "verifier:solutions": "node scripts/verifier-solutions.mjs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@clerk/backend": "^3.20.1",
    "@nestjs/apollo": "^14.0.2",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.1",
    "@nestjs/websockets": "^12.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "joi": "^18.2.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.6.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
